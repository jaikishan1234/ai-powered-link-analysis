# Copy this file to `.env` and adjust values for your environment.
# Never commit a real `.env` file or real credentials.

APP_NAME="AI-Powered Website Link Analysis API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
# Must be false when ENVIRONMENT=production.
DEBUG=false
HOST=0.0.0.0
PORT=4000

# LLM provider credential. Leave blank to disable; empty or whitespace-only
# values are treated as unset.
LLM_API_KEY=
