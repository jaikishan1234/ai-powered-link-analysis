# Copy this file to `.env` and adjust values for your environment.
# Never commit a real `.env` file or real credentials.

APP_NAME="AI-Powered Website Link Analysis API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
# Must be false when ENVIRONMENT=production.
DEBUG=false
HOST=0.0.0.0
PORT=4000

# Outbound website fetching (safe SSRF-protected fetching).
FETCH_TIMEOUT_SECONDS=10.0
FETCH_MAX_RESPONSE_BYTES=2000000
FETCH_MAX_REDIRECTS=5

# Maximum number of characters kept from extracted page text.
EXTRACT_MAX_TEXT_CHARS=20000

# LLM provider credential. Leave blank to disable; empty or whitespace-only
# values are treated as unset.
LLM_API_KEY=

# NVIDIA NIM base URL for the OpenAI-compatible Chat Completions API.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model name used for chat completions.
LLM_MODEL=vidia/nemotron-3.5-bolt-e4b

# Per-request timeout for LLM calls, in seconds.
LLM_TIMEOUT_SECONDS=30.0
